{
  "name": "sarvha-storefront",
  "version": "1.0.0",
  "description": "Static storefront for Sarvha, a direct-to-consumer essential oil brand.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.mjs",
    "dev:server": "node --env-file-if-exists=.env.local --watch server.mjs",
    "dev": "node build.mjs && python -m http.server 4321 --directory dist",
    "serve": "python -m http.server 4321 --directory dist",
    "seo": "node build.mjs && node seo-audit.mjs",
    "test": "node --test test/*.test.mjs",
    "seed": "node --env-file-if-exists=.env.local db/seed-stock.mjs",
    "db:setup": "node --env-file-if-exists=.env.local db/setup.mjs",
    "db:check": "node --env-file-if-exists=.env.local db/check.mjs",
    "smoke": "node --env-file-if-exists=.env.local db/smoke.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "express": "^5.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
