# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way: two of these values can move money.
#
# In production these are set in the host's dashboard (Vercel: Project →
# Settings → Environment Variables), never in a file in the repository.

# Postgres. Neon gives a free database; any Postgres with a pooled HTTP
# endpoint works. Must include ?sslmode=require.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Razorpay → Settings → API Keys.
# The key id is public and is sent to the browser. The secret is not, and
# anyone holding it can take payments as you.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""

# Razorpay → Settings → Webhooks. You choose this string when creating the
# webhook; it is not shown to you anywhere else afterwards.
RAZORPAY_WEBHOOK_SECRET=""
