# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way: two of these values can move money.
#
# In production these are set in the host's dashboard (Vercel: Project →
# Settings → Environment Variables), never in a file in the repository.

# Postgres. Neon gives a free database; any Postgres with a pooled HTTP
# endpoint works. Must include ?sslmode=require.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Razorpay → Settings → API Keys.
# The key id is public and is sent to the browser. The secret is not, and
# anyone holding it can take payments as you.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""

# Razorpay → Settings → Webhooks. You choose this string when creating the
# webhook; it is not shown to you anywhere else afterwards.
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------- email
# Until these are set, the thank-you button in /admin/ is disabled and says
# why, and marking an order shipped tells you the customer was not emailed.
# Nothing pretends a message was sent.
#
# EMAIL_PROVIDER: "brevo" or "resend".
#   brevo  — verify a single sender address (a Gmail address is fine) and
#            send from it. The one that works before you own a domain.
#   resend — expects a domain you control; until one is verified it will
#            only deliver to your own address.
EMAIL_PROVIDER="brevo"
EMAIL_API_KEY=""

# The address customers see as the sender. It must be one the provider has
# verified, or every send is refused.
EMAIL_FROM=""
EMAIL_FROM_NAME="Sarvha"

# Where replies should go, if different from EMAIL_FROM. Worth setting:
# hello@sarvha.com does not exist yet, so a reply to it goes nowhere.
EMAIL_REPLY_TO=""

# Where the shop actually is today. site.url in src/data.mjs is the domain
# the site will have one day; emails must point somewhere that resolves now.
# Delete this once the real domain is live.
PUBLIC_URL="https://oil-ten-omega.vercel.app"

# -------------------------------------------------------- google sheet
# Mirrors every order into one spreadsheet, so there is a living sheet to
# open rather than a file to download. The admin button is disabled and says
# why until these are set.
#
# The sheet is never the source of truth: the sync rewrites it to match the
# database, so running it twice cannot duplicate a row and a failed run
# cannot leave a gap.
#
# Setup is in DEPLOY.md. In short: a Google Cloud service account, the Sheets
# API enabled, and the sheet shared with the service account's address as an
# Editor — that last step is the one everybody forgets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# The whole PEM from the service account's JSON key, on one line with the
# newlines written as \n. Pasting it with real newlines will not survive a
# hosting dashboard, and the error Google gives says nothing about the cause.
GOOGLE_PRIVATE_KEY=""

# From the sheet's own URL:
# docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=""
