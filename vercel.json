{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/*.js": { "runtime": "nodejs22.x" }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "x-robots-tag", "value": "noindex" }]
    }
  ]
}
